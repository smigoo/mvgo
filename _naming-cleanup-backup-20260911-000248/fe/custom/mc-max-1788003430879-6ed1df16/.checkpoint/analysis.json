    "cssClasses": {
      "comment": "可复用的CSS类 - 浅色科技监测风",
      ".monitor-container": {
        "display": "flex",
        "flex-direction": "column",
        "width": "100%",
        "height": "100%",
        "padding": "1.2em",
        "background": "linear-gradient(180deg, rgba(237, 244, 251, 1) 0%, rgba(255, 255, 255, 1) 100%)",
        "color": "var(--colorTextBase, @color-text-base)",
        "font-size": "var(--fontSize, @font-size-base)"
      },
      ".tab-bar": {
        "display": "flex",
        "align-items": "center",
        "gap": "0.5em",
        "padding": "0.4em",
        "background": "linear-gradient(90deg, rgba(85, 158, 255, 0.08) 0%, rgba(255, 255, 255, 0.65) 100%)",
        "border-radius": "var(--borderRadius, @border-radius-base)"
      },
      ".tab-item": {
        "padding": "0.4em 1em",
        "border-radius": "0.4em",
        "cursor": "pointer",
        "color": "var(--colorTextSecondary, @color-text-secondary)",
        "transition": "background 0.2s ease, color 0.2s ease"
      },
      ".tab-item.is-active": {
        "background": "var(--colorPrimary, @color-primary)",
        "color": "#ffffff",
        "font-weight": "500"
      },
      ".metric-value": {
        "color": "var(--colorEmphasis, @color-emphasis)",
        "font-size": "var(--titleSize, @title-size)",
        "font-weight": "600"
      },
      ".panel-card": {
        "background": "var(--colorPanelBg, @color-panel-bg)",
        "border-radius": "var(--borderRadius, @border-radius-base)",
        "padding": "1em",
        "backdrop-filter": "blur(8px)"
      },
      ".threshold-line": {
        "border-top": "1px dashed var(--colorThreshold, @color-threshold)",
        "position": "relative"
      },
      ".threshold-label": {
        "color": "var(--colorDanger, @color-danger)",
        "font-size": "0.85em"
      },
      ".chart-area-fill": {
        "comment": "绿色渐变面积图填充，供ECharts areaStyle参考",
        "background": "linear-gradient(180deg, rgba(82, 196, 26, 0.3) 0%, rgba(82, 196, 26, 0) 100%)"
      }
    },
