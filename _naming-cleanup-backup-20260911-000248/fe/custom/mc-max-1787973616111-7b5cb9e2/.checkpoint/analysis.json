    "cssClasses": {
      "comment": "可复用的CSS类",
      ".stat-value-primary": {
        "fontSize": "var(--fontSizeXl)",
        "fontWeight": "600",
        "color": "var(--colorPrimary)",
        "textShadow": "var(--shadowGlow)",
        "lineHeight": "1.2"
      },
      ".ring-glow-effect": {
        "position": "relative",
        "&::before": {
          "content": "''",
          "position": "absolute",
          "inset": "-8px",
          "borderRadius": "50%",
          "border": "2px solid var(--colorPrimary)",
          "opacity": "0.3",
          "animation": "pulse 2s ease-in-out infinite"
        }
      },
      ".threshold-line": {
        "borderTop": "2px dashed var(--colorDanger)",
        "position": "relative",
        "&::after": {
          "content": "'建议分流'",
          "position": "absolute",
          "right": "8px",
          "top": "-10px",
          "fontSize": "12px",
          "color": "var(--colorDanger)",
          "background": "var(--colorBgContainer)",
          "padding": "0 4px"
        }
      },
      ".accuracy-badge": {
        "display": "inline-flex",
        "alignItems": "center",
        "padding": "2px 8px",
        "borderRadius": "var(--borderRadiusBase)",
        "fontSize": "12px",
        "fontWeight": "500",
        "background": "var(--colorSuccess)",
        "color": "#ffffff",
        "gap": "4px"
      },
      ".diamond-icon": {
        "width": "12px",
        "height": "12px",
        "transform": "rotate(45deg)",
        "background": "var(--colorPrimary)",
        "border": "1px solid var(--colorPrimary)",
        "opacity": "0.8"
      },
      ".card-container": {
        "background": "var(--colorBgContainer)",
        "borderRadius": "var(--borderRadiusLg)",
        "padding": "16px 20px",
        "boxShadow": "var(--shadowBase)",
        "transition": "all 0.3s ease"
      },
      ".chart-tooltip-highlight": {
        "position": "relative",
        "&::before": {
          "content": "''",
          "position": "absolute",
          "top": "-4px",
          "left": "50%",
          "transform": "translateX(-50%)",
          "width": "8px",
          "height": "8px",
          "borderRadius": "50%",
          "background": "var(--colorPrimary)",
          "boxShadow": "0 0 8px var(--colorPrimary)"
        }
      },
      ".gradient-bg": {
        "background": "linear-gradient(135deg, #edf4fb 0%, #f5f9fd 100%)"
      }
