.light .c-mc-1785309141220-493d3a5e-content {
  flex: 1;
  display: flex;
  gap: 12px;
  overflow: hidden;
  margin-top: 12px;
  min-height: 0;
}
.light .c-mc-1785309141220-493d3a5e-switch {
  display: flex;
  gap: 10px;
  flex-shrink: 0;
}
.light .c-mc-1785309141220-493d3a5e-switch-item {
  position: relative;
  width: 193px;
  height: 65px;
  cursor: pointer;
  flex-shrink: 0;
}
.light .c-mc-1785309141220-493d3a5e-switch-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}
.light .c-mc-1785309141220-493d3a5e-switch-icon {
  position: absolute;
  left: 12px;
  top: 4px;
  width: 48px;
  height: 38px;
  z-index: 1;
  object-fit: contain;
}
.light .c-mc-1785309141220-493d3a5e-switch-title {
  position: absolute;
  left: 14px;
  bottom: 12px;
  font-size: 12px;
  font-weight: 400;
  font-family: 'YouSheBiaoTiHei', sans-serif;
  z-index: 1;
  line-height: 16px;
}
.light .c-mc-1785309141220-493d3a5e-switch-data {
  position: absolute;
  right: 16px;
  top: 6px;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.light .c-mc-1785309141220-493d3a5e-switch-data-row {
  display: flex;
  align-items: baseline;
  gap: 4px;
}
.light .c-mc-1785309141220-493d3a5e-switch-data-label {
  font-size: 14px;
  font-weight: 400;
  font-family: 'Source Han Sans CN', sans-serif;
  line-height: 21px;
}
.light .c-mc-1785309141220-493d3a5e-switch-data-value {
  font-size: 20px;
  font-weight: 700;
  font-family: 'Roboto', sans-serif;
  line-height: 23px;
  background: linear-gradient(180deg, #e1f0ff 0%, #00ccff 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  color: #1990ff;
}
.light .c-mc-1785309141220-493d3a5e-switch-data-value--error {
  /* [Style Refine] Figma fills -> 异常数红色 #e03434 */
  background: linear-gradient(180deg, #e1f0ff 0%, #00ccff 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  color: #e03434;
}
.light .c-mc-1785309141220-493d3a5e-switch-item.is-active .c-mc-1785309141220-493d3a5e-switch-title,
.light .c-mc-1785309141220-493d3a5e-switch-item.is-active .c-mc-1785309141220-493d3a5e-switch-data-label {
  color: #ffffff;
}
.light .c-mc-1785309141220-493d3a5e-switch-item:not(.is-active) .c-mc-1785309141220-493d3a5e-switch-title,
.light .c-mc-1785309141220-493d3a5e-switch-item:not(.is-active) .c-mc-1785309141220-493d3a5e-switch-data-label {
  color: #333333;
}
.light .c-mc-1785309141220-493d3a5e-vtabs {
  display: flex;
  flex-direction: column;
  width: 46px;
  gap: 3px;
  flex-shrink: 0;
}
.light .c-mc-1785309141220-493d3a5e-vtab-item {
  /* [Style Refine] Figma fills -> 渐变背景 + 边框 #f0f5ff */
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  cursor: pointer;
  background: linear-gradient(90deg, #85baff 0%, #bfe3ff 100%);
  border: 1px solid #f0f5ff;
  box-sizing: border-box;
  transition: all 0.3s;
}
.light .c-mc-1785309141220-493d3a5e-vtab-text {
  /* [Style Refine] Figma fills -> #3b80e6 */
  font-size: 14px;
  font-weight: 400;
  color: #3b80e6;
  text-align: center;
  writing-mode: vertical-rl;
  letter-spacing: 2px;
  font-family: 'Source Han Sans CN', sans-serif;
}
.light .c-mc-1785309141220-493d3a5e-vtab-item.is-active {
  /* [Style Refine] Figma fills -> active 渐变背景 */
  background: linear-gradient(90deg, #318aff 0%, #70bfff 100%);
  border: 1px solid #f0f5ff;
}
.light .c-mc-1785309141220-493d3a5e-vtab-item.is-active .c-mc-1785309141220-493d3a5e-vtab-text {
  color: #ffffff;
  font-weight: 700;
}
.light .c-mc-1785309141220-493d3a5e-device-grid {
  flex: 1;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-template-rows: repeat(4, 1fr);
  /* [Layout Refine] Figma bbox 计算 gap: row 13px, col 8px */
  gap: 13px 8px;
  overflow: hidden;
  min-height: 0;
}
.light .c-mc-1785309141220-493d3a5e-device-card {
  position: relative;
  display: flex;
  align-items: center;
  padding: 12px;
  box-sizing: border-box;
}
.light .c-mc-1785309141220-493d3a5e-device-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}
.light .c-mc-1785309141220-493d3a5e-device-icon {
  width: 36px;
  height: 44px;
  z-index: 1;
  margin-right: 12px;
  object-fit: contain;
  flex-shrink: 0;
}
.light .c-mc-1785309141220-493d3a5e-device-info {
  display: flex;
  flex-direction: column;
  z-index: 1;
  overflow: hidden;
}
.light .c-mc-1785309141220-493d3a5e-device-name {
  /* [Style Refine] Figma fills -> #333333, 12px */
  font-size: 12px;
  font-weight: 400;
  color: #333333;
  line-height: 18px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-family: 'Source Han Sans CN', sans-serif;
}
.light .c-mc-1785309141220-493d3a5e-device-count {
  /* [Style Refine] Figma fills -> #ffffff, effects -> drop-shadow 0 0 rgba(0,0,0,0.5) */
  font-size: 16px;
  font-weight: 500;
  font-family: 'Roboto', sans-serif;
  color: #ffffff;
  text-shadow: 0 0 0 rgba(0, 0, 0, 0.5);
  line-height: 19px;
  margin-top: 4px;
}