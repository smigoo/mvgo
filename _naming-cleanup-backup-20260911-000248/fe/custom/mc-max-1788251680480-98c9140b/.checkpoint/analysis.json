      ".c-container": {
        "width": "100%",
        "height": "100%",
        "display": "flex",
        "flex-direction": "column",
        "background": "linear-gradient(135deg, var(--colorBgGradientStart, @color-bg-gradient-start) 0%, var(--colorBgGradientEnd, @color-bg-gradient-end) 100%)",
