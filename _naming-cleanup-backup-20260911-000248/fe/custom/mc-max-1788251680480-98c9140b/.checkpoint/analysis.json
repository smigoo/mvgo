        "color": "#ffffff",
        "font-size": "0.75em",
        "font-weight": "var(--fontWeightStrong, @font-weight-strong)",
        "border-radius": "0 var(--borderRadius, @border-radius-base) 0 var(--borderRadius, @border-radius-base)",
        "line-height": "1.6em"
      },
      ".c-chart-container": {
        "flex": "1",
