        "position": "relative",
        "background": "rgba(255, 255, 255, 0.85)",
        "border": "1px solid rgba(25, 144, 255, 0.2)",
        "border-radius": "var(--borderRadius)",
        "padding": "16px",
        "box-shadow": "0 2px 8px rgba(25, 144, 255, 0.08)"
      },
      ".emphasis-value-primary": {
        "font-size": "var(--fontSizeLarge)",
        "font-weight": "700",
        "color": "var(--colorPrimary)",
        "line-height": "1.2"
      },
      ".emphasis-value-error": {
        "font-size": "var(--fontSizeLarge)",
        "font-weight": "700",
        "color": "var(--colorError)",
        "line-height": "1.2"
      }
    },
