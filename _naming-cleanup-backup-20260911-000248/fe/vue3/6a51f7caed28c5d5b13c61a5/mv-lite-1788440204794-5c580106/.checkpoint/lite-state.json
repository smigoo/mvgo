: #E2E8F0;\n  font-family: 'Microsoft YaHei', sans-serif;\n  display: flex;\n  flex-direction: column;\n  padding: 10px;\n  overflow: hidden;\n}\n\n/* 标题栏 */\n.jiangbei-work-well-header {\n  height: 40px;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  background: linear-gradient(90deg, rgba(11, 46, 51, 0.8) 0%, rgba(5, 22, 26, 0) 100%);\n  border-bottom: 1px solid #1A4F56;\n  margin-bottom: 10px;\n  padding: 0 10px;\n}\n\n.header-left {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.header-icon {\n  width: 20px;\n  height: 20px;\n  background-color: #00E5FF;\n  clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%);\n  opacity: 0.8;\n}\n\n.header-title {\n  font-size: 18px;\n  font-weight: bold;\n  margin: 0;\n  color: #E2E8F0;\n  letter-spacing: 1px;\n}\n\n.header-close {\n  background: none;\n  border: none;\n  color: #E2E8F0;\n  font-size: 20px;\n  cursor: pointer;\n  padding: 0 5px;\n}\n\n.header-close:hover {\n  color: #00E5FF;\n}\n\n/* 内容区 */\n.jiangbei-work-well-content {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  min-height: 0;\n  overflow-y: auto;\n}\n\n/* 板块 */\n.jiangbei-work-well-section {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.section-header {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin-bottom: 4px;\n}\n\n.section-icon {\n  width: 16px;\n  height: 16px;\n  background-color: #00E5FF;\n  clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%);\n  opacity: 0.6;\n}\n\n.section-title {\n  font-size: 14px;\n  font-weight: bold;\n  margin: 0;\n  color: #E2E8F0;\n}\n\n/* 网格布局 */\n.card-grid {\n  display: grid;\n  gap: 12px;\n  width: 100%;\n}\n\n.grid-4-col {\n  grid-template-columns: repeat(4, 1fr);\n}\n\n.grid-2-rows {\n  grid-template-rows: repeat(2, min-content);\n}\n\n/* 卡片 */\n.device-card {\n  background-color: rgba(11, 46, 51, 0.5);\n  border: 1px solid #1A4F56;\n  border-radius: 4px;\n  padding: 10px;\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n  position: relative;\n  min-height: 90px;\n}\n\n.card-alert {\n  border-color: #8B0000;\n  background-color: rgba(60, 20, 20, 0.4);\n  box-shadow: inset 0 0 10px rgba(139, 0, 0, 0.2);\n}\n\n.card-body {\n  display: flex;\n  align-items: flex-start;\n  gap: 10px;\n  margin-bottom: 8px;\n}\n\n.card-icon-wrapper {\n  width: 40px;\n  height: 40px;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  background: radial-gradient(circle, rgba(0, 229, 255, 0.1) 0%, transparent 70%);\n  border-radius: 50%;\n}\n\n.device-icon {\n  width: 24px;\n  height: 24px;\n  filter: drop-shadow(0 0 2px #00E5FF);\n}\n\n.fan-icon-large {\n  width: 32px;\n  height: 32px;\n}\n\n.valve-icon {\n  width: 24px;\n  height: 24px;\n}\n\n.card-info {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  min-width: 0; /* 防止文字溢出 */\n}\n\n.info-top {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  flex-wrap: wrap;\n}\n\n.device-name {\n  font-size: 13px;\n  font-weight: bold;\n  color: #E2E8F0;\n  white-space: nowrap;\n}\n\n.status-tag {\n  font-size: 10px;\n  padding: 1px 4px;\n  border-radius: 2px;\n  color: #fff;\n}\n\n.tag-online {\n  background-color: #2E7D32;\n}\n\n.tag-offline {\n  background-color: #546E7A;\n}\n\n.info-status {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  font-size: 11px;\n  color: #94A3B8;\n}\n\n.status-dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  display: inline-block;\n}\n\n.dot-green {\n  background-color: #00E676;\n  box-shadow: 0 0 4px #00E676;\n}\n\n.dot-gray {\n  background-color: #78909C;\n}\n\n.status-text {\n  margin-right: 6px;\n}\n\n.card-footer {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-top: auto;\n  padding-top: 8px;\n  border-top: 1px solid rgba(26, 79, 86, 0.5);\n}\n\n.radio-group {\n  display: flex;\n  gap: 12px;\n}\n\n.radio-label {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  cursor: pointer;\n  font-size: 11px;\n  color: #94A3B8;\n}\n\n.radio-input {\n  display: none;\n}\n\n.radio-custom {\n  width: 10px;\n  height: 10px;\n  border: 1px solid #78909C;\n  border-radius: 50%;\n  display: inline-block;\n  position: relative;\n}\n\n.radio-input:checked + .radio-custom {\n  border-color: #00E5FF;\n}\n\n.radio-input:checked + .radio-custom::after {\n  content: '';\n  position: absolute;\n  top: 2px;\n  left: 2px;\n  width: 4px;\n  height: 4px;\n  background-color: #00E5FF;\n  border-radius: 50%;\n}\n\n.btn-execute {\n  background-color: #00838F;\n  color: #fff;\n  border: none;\n  padding: 4px 12px;\n  border-radius: 2px;\n  font-size: 11px;\n  cursor: pointer;\n  transition: background 0.2s;\n}\n\n.btn-execute:hover {\n  background-color: #00E5FF;\n  color: #05161A;\n}\n\n/* Tooltip 特殊处理 */\n.card-tooltip-wrapper {\n  position: relative;\n  overflow: visible; /* 允许 tooltip 溢出 */\n}\n\n.tooltip-box {\n  position: absolute;\n  top: -50px;\n  left: 0;\n  right: 0;\n  background-color: rgba(11, 46, 51, 0.95);\n  border: 1px solid #00E5FF;\n  padding: 6px;\n  border-radius: 4px;\n  z-index: 10;\n  font-size: 11px;\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);\n  pointer-events: none; /* 防止遮挡 */\n}\n\n.tooltip-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 4px;\n  color: #00E5FF;\n  font-weight: bold;\n}\n\n.tooltip-icon {\n  font-size: 12px;\n  cursor: help;\n}\n\n.tooltip-content {\n  color: #E2E8F0;\n  font-size: 10px;\n}\n\n/* 响应式调整 (虽然题目要求固定逻辑尺寸，但防止极端情况) */\n@media (max-width: 600px) {\n  .grid-4-col {\n    grid-template-columns: repeat(2, 1fr);\n  }\n}\n</style>"
