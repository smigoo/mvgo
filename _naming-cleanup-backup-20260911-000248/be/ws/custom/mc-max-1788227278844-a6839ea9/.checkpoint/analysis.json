    "cssClasses": {
      "comment": "可复用CSS类（浅色科技监测风：白/浅蓝渐变背景、卡片面板、Tab激活态、折线图渐变、预警虚线、圆角Badge）",
      ".page-container": {
        "width": "100%",
        "height": "100%",
        "background": "linear-gradient(180deg, var(--colorBgGradientStart, #ffffff) 0%, var(--colorBgGradientEnd, #eaf3ff) 100%)",
        "display": "flex",
        "flex-direction": "column",
        "box-sizing": "border-box"
      },
      ".panel-card": {
        "background": "#ffffff",
        "border-radius": "var(--borderRadius, 8px)",
        "box-shadow": "0 2px 12px rgba(78, 155, 255, 0.08)",
        "padding": "1em",
        "box-sizing": "border-box"
      },
      ".tab-group": {
        "display": "flex",
        "gap": "0.5em",
        "align-items": "center"
      },
      ".tab-item": {
        "padding": "0.4em 1em",
        "border-radius": "var(--borderRadiusSm, 4px)",
        "font-size": "var(--fontSize, 14px)",
        "color": "var(--colorTextBase, @color-text-primary)",
        "background": "transparent",
        "cursor": "pointer",
        "transition": "all 0.2s ease"
      },
      ".tab-item.active": {
        "background": "var(--colorPrimary, @color-primary)",
        "color": "#ffffff",
        "font-weight": "var(--fontWeightStrong, 600)"
      },
      ".chart-line-area": {
        "comment": "折线图渐变填充区域，需在ECharts series.areaStyle中使用linear-gradient",
        "fill": "linear-gradient(180deg, rgba(78,155,255,0.3) 0%, rgba(78,155,255,0) 100%)"
      },
      ".warning-line": {
        "comment": "预警虚线，红色，用于ECharts markLine或DOM分割线",
        "border-top": "1px dashed var(--colorWarning, @color-warning)",
        "position": "absolute",
        "width": "100%"
      },
      ".badge": {
        "display": "inline-flex",
        "align-items": "center",
        "justify-content": "center",
        "min-width": "1.6em",
        "height": "1.6em",
        "padding": "0 0.4em",
        "border-radius": "var(--borderRadius, 8px)",
        "background": "var(--colorPrimary, @color-badge-bg)",
        "color": "#ffffff",
        "font-size": "0.85em",
        "font-weight": "var(--fontWeightStrong, 600)"
      },
      ".text-secondary": {
        "color": "var(--colorTextSecondary, @color-text-secondary)",
        "font-size": "0.9em"
      }
    },
    "tokenCoverage": 0.95,
    "mappingNotes": [
      "主色 #4e9bff 映射为 --colorPrimary，用于Tab激活态背景、Badge背景、折线图主色",
      "辅助色 #5ad8a6（成功/正常状态）映射为 --colorSuccess，#ff4d4f（预警/告警）映射为 --colorWarning，用于预警虚线和红色数值",
      "背景采用白色到浅蓝的线性渐变（#ffffff → #eaf3ff）实现'白色/浅蓝渐变背景'效果，落地为 .page-container 的字面量渐变值，不完全依赖CSS变量，保证关键可见背景稳定渲染",
      "卡片面板 .panel-card 使用纯白背景 + 浅蓝色阴影模拟科技感浮层效果",
      "Tab激活态（如'一氧化碳'蓝底白字）通过 .tab-item.active 类实现，背景色取主色 --colorPrimary",
      "预警线（红色虚线，30刻度）建议在ECharts中通过 markLine 的 lineStyle: { type: 'dashed', color: 'var(--colorWarning)' } 实现，.warning-line 类作为DOM兜底方案",
      "折线图渐变填充区域需在ECharts js配置中用 areaStyle.color 设置 linear-gradient 对象，css中的 .chart-line-area 仅作参考色值",
      "圆角Badge数字标使用 .badge 类，背景色可根据业务状态在 --colorPrimary/--colorWarning/--colorSuccess 间切换",
      "文字主色 #333333 映射为 --colorTextBase，辅助文字色 #999999 映射为 --colorTextSecondary，用于图表坐标轴、说明文字等次要信息",
      "所有尺寸使用 em 或 $mcCssBuilder.getCssSize() 响应式单位，避免固定px值（除边框等极小尺寸）"
    ],
