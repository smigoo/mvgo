    "cssClasses": {
      "comment": "可复用的CSS类",
      ".tech-monitor-container": {
        "width": "100%",
        "height": "100%",
        "background": "linear-gradient(180deg, #ffffff 0%, rgba(246, 248, 250, 1) 100%)",
        "padding": "var(--spacingBase)",
        "display": "flex",
        "flex-direction": "column",
        "gap": "var(--spacingBase)"
      },
      ".left-nav": {
        "display": "flex",
        "flex-direction": "column",
        "background": "var(--colorBgNav)",
        "border-radius": "var(--borderRadiusBase)",
        "padding": "12px",
        "gap": "8px",
        "backdrop-filter": "blur(10px)"
      },
      ".device-card": {
        "background": "var(--colorBgGray)",
        "border-radius": "var(--borderRadiusCard)",
        "padding": "var(--spacingCard)",
        "display": "flex",
        "flex-direction": "column",
        "gap": "12px",
        "box-shadow": "0 2px 8px rgba(0, 0, 0, 0.04)"
      },
      ".highlight-card": {
        "background": "var(--colorBgCard)",
        "border-radius": "var(--borderRadiusCard)",
        "padding": "var(--spacingCard)",
        "border": "1px solid rgba(25, 144, 255, 0.2)"
      },
      ".stat-value": {
        "font-size": "var(--fontSizeValue)",
        "font-weight": "600",
        "color": "var(--colorPrimary)",
        "line-height": "1.2"
      },
      ".stat-value-error": {
        "font-size": "var(--fontSizeValue)",
        "font-weight": "600",
        "color": "var(--colorError)",
        "line-height": "1.2"
      },
      ".stat-value-success": {
        "font-size": "var(--fontSizeValue)",
        "font-weight": "600",
        "color": "var(--colorSuccess)",
        "line-height": "1.2"
      },
      ".stat-label": {
        "font-size": "var(--fontSize)",
        "color": "var(--colorTextSecondary)",
        "line-height": "1.5"
      },
      ".progress-indicator": {
        "display": "flex",
        "align-items": "center",
        "gap": "8px",
        "font-size": "var(--fontSize)",
        "color": "var(--colorTextBase)"
      },
      ".progress-bar": {
        "height": "4px",
        "background": "rgba(25, 144, 255, 0.1)",
        "border-radius": "2px",
        "overflow": "hidden",
        "flex": "1"
      },
      ".progress-bar-fill": {
        "height": "100%",
        "background": "linear-gradient(90deg, var(--colorPrimary) 0%, var(--colorPrimaryLight) 100%)",
        "transition": "width 0.3s ease"
      },
      ".section-title": {
        "font-size": "var(--fontSizeTitle)",
        "font-weight": "500",
        "color": "var(--colorTextBase)",
        "margin-bottom": "12px"
      },
      ".card-grid": {
        "display": "grid",
        "grid-template-columns": "repeat(auto-fit, minmax(200px, 1fr))",
        "gap": "var(--spacingBase)"
      }
    },
