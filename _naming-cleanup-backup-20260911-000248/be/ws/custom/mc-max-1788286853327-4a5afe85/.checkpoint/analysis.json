  "reviewResult": {
    "reviewResult": "warning",
    "score": 72,
    "issues": [
      {
        "level": "error",
        "type": "structure",
        "location": "layout.sections[3] (left-nav)",
        "message": "左侧导航栏作为独立 section 且用绝对定位，应作为全局布局元素而非内容 section",
        "suggestion": "将导航栏提升到 layout 顶层作为 aside 区域，或标记为 layout-overlay 类型"
      },
      {
        "level": "warning",
        "type": "structure",
        "location": "layout.sections[0] (header-stats)",
        "message": "headerRelation 标记为 title-same-row 但无 header 字段，语义矛盾",
        "suggestion": "若统计栏本身就是标题行内容，应设 headerRelation: null 或 'no-header'"
      },
      {
        "level": "warning",
        "type": "nesting_depth",
        "location": "sections[1].body.children[*].children[1].elements",
        "message": "featured-card 内嵌套 4 层（card > content > elements > parts），略复杂",
        "suggestion": "考虑将 parts 数组扁平化到 elements 层级，减少一层嵌套"
      },
      {
        "level": "warning",
        "type": "naming",
        "location": "sections[1].body.children[*].id",
        "message": "突出设备卡片 id 为 device-left/right，但实际名称是'随便说说'等，命名不匹配内容",
        "suggestion": "使用语义化 id 如 featured-device-tunnel / featured-device-building"
      },
      {
        "level": "warning",
        "type": "structure",
        "location": "layout.sections[2] (device-grid)",
        "message": "12 个设备卡片共用同一背景图 bg-8439.png，应提取到 body 层级避免重复",
        "suggestion": "在 body 设置统一背景，children 继承样式，减少冗余配置"
      }
    ],
    "recommendations": [
      "将左侧导航栏从 sections 数组提取到 layout 顶层，作为 { type: 'aside-left', ... } 结构",
      "统一 featured-card 和 device-card 的数据结构，减少类型差异（如都用 value + label 模式）",
      "为 grid 布局添加响应式配置（gridColumns: { sm: 2, md: 3, lg: 4 }），提升适配性"
    ],
    "summary": "结构基本合理，但左侧导航栏的定位方式与 section 模型冲突，统计栏的 headerRelation 语义不清，设备卡片嵌套略深且命名欠佳。建议调整导航栏层级并优化卡片结构。"
  },
