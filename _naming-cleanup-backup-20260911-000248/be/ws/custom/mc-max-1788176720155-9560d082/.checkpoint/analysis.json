      "comment": "可复用的CSS类",
      ".panel-container": {
        "background": "rgba(237, 244, 251, 1)",
        "border-radius": "var(--borderRadiusBase, @border-radius-base)",
        "padding": "1.5em",
        "position": "relative",
        "overflow": "hidden"
      },
      ".panel-header": {
        "display": "flex",
        "align-items": "center",
        "margin-bottom": "1em",
        "position": "relative"
      },
      ".panel-header::before": {
        "content": "''",
        "position": "absolute",
        "top": "0",
        "left": "0",
        "width": "100%",
        "height": "3px",
        "background": "var(--colorPrimary, @color-primary)"
      },
      ".panel-title": {
        "display": "flex",
        "align-items": "center",
        "font-size": "var(--fontSizeTitle, @font-size-title)",
        "font-weight": "500",
        "color": "var(--colorTextPrimary, @color-text-primary)",
        "background": "linear-gradient(90deg, var(--colorPrimary, @color-primary) 0%, var(--colorSuccess, @color-success) 100%)",
        "-webkit-background-clip": "text",
        "-webkit-text-fill-color": "transparent",
        "background-clip": "text"
      },
      ".panel-title::before": {
        "content": "''",
        "display": "inline-block",
        "width": "0.5em",
        "height": "0.5em",
        "margin-right": "0.5em",
        "background": "var(--colorPrimary, @color-primary)",
        "transform": "rotate(45deg)"
      },
      ".tab-container": {
        "display": "flex",
        "gap": "0.5em",
        "margin-bottom": "1em"
      },
      ".tab-item": {
        "padding": "0.5em 1em",
        "font-size": "var(--fontSize, @font-size-base)",
        "color": "var(--colorTextSecondary, @color-text-secondary)",
        "background": "transparent",
        "border": "1px solid transparent",
        "border-radius": "var(--borderRadiusBase, @border-radius-base)",
        "cursor": "pointer",
        "transition": "all 0.3s ease"
      },
      ".tab-item.active": {
        "color": "var(--colorPrimary, @color-primary)",
        "background": "rgba(24, 144, 255, 0.1)",
        "border-color": "var(--colorPrimary, @color-primary)"
      },
      ".chart-container": {
        "width": "100%",
        "height": "300px",
        "position": "relative"
      },
