        "color": "var(--colorTextBase, @color-tab-default-text)",
        "cursor": "pointer",
        "border-radius": "0 var(--borderRadiusSm, @border-radius-sm) var(--borderRadiusSm, @border-radius-sm) 0",
        "transition": "background 0.2s, color 0.2s",
        "opacity": "0.7"
      },
      ".left-tabs__item::before": {
        "content": "''",
        "position": "absolute",
        "left": "0",
        "top": "15%",
        "height": "70%",
