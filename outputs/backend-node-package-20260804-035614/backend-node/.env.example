# LangGraph Server 配置文件

# ============================================
# 环境变量配置
# ============================================

# ============================================
# 多 Provider 配置：视觉任务与文本任务分离
# ============================================

# 视觉任务（Preview 阶段 - 图像分析/VisualParser）
# 推荐：Qwen (qwen3.7-plus) @ DashScope
MC_GEN_AI_API_KEY=<your-vision-api-key>
MC_GEN_AI_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
MC_GEN_VISION_MODEL=qwen3.7-plus

# 向后兼容 - VISION_* 变量（会被 MC_GEN_* 覆盖）
VISION_API_KEY=<your-vision-api-key>
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen3.7-plus

# 文本任务（Figma/req 阶段 - 代码生成/审查/布局分析）
# 推荐：Claude Opus (claude-opus-4-8)
MC_GEN_TEXT_API_KEY=<your-text-api-key>
MC_GEN_TEXT_ENDPOINT=https://your-claude-proxy.example.com/v1
MC_GEN_TEXT_MODEL=claude-opus-4-8

# 向后兼容 - TEXT_* 变量（会被 MC_GEN_TEXT_* 覆盖）
TEXT_API_KEY=<your-text-api-key>
TEXT_BASE_URL=https://your-claude-proxy.example.com/v1
TEXT_MODEL=claude-opus-4-8

# 向后兼容（未设置上述变量时回退到此）
ANTHROPIC_API_KEY=<your-anthropic-api-key>
ANTHROPIC_BASE_URL=https://your-claude-proxy.example.com/v1
ANTHROPIC_MODEL=claude-opus-4-8

# Figma API
FIGMA_ACCESS_TOKEN=<your-figma-access-token>
FIGMA_FILE_KEY=abc123  # 默认文件 Key（可被参数覆盖）

# ============================================
# 服务配置
# ============================================

# HTTP 服务器（可选）
ENABLE_HTTP_SERVER=false
HTTP_PORT=3000
HTTP_HOST=localhost

# ============================================
# 智能体配置
# ============================================

# 默认模型配置
DEFAULT_MODEL=claude-sonnet-4-6
DEFAULT_TEMPERATURE=0.2
DEFAULT_MAX_TOKENS=4096

# 各智能体的模型配置（可覆盖默认值）
FIGMA_DATA_ANALYST_MODEL=claude-sonnet-4-6
STYLE_REFINER_MODEL=claude-sonnet-4-6
LAYOUT_REFINER_MODEL=claude-sonnet-4-6
SPACING_REFINER_MODEL=claude-sonnet-4-6
CODE_VALIDATOR_MODEL=claude-sonnet-4-6
ADVERSARIAL_VALIDATOR_MODEL=claude-opus-4-8  # 对抗性验证使用最强模型
ARBITER_MODEL=claude-opus-4-8  # 仲裁师使用最强模型

# ============================================
# 工作流配置
# ============================================

# 并行精修超时时间（毫秒）
REFINE_TIMEOUT=60000

# 最大重试次数
MAX_RETRY_ATTEMPTS=3

# 置信度阈值（低于此值会触发重试）
CONFIDENCE_THRESHOLD=0.8

# ============================================
# 成本控制
# ============================================

# 单次运行 Token 预算（0 表示无限制）
TOKEN_BUDGET=50000

# Token 预算警告阈值（百分比）
BUDGET_WARNING_THRESHOLD=0.8

# ============================================
# 日志与追踪
# ============================================

# 日志级别：debug | info | warn | error
LOG_LEVEL=info

# 启用 LangSmith 追踪
ENABLE_LANGSMITH=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT_NAME=mc-generation

# ============================================
# 代码规范
# ============================================

# 自动运行 ESLint 修复
AUTO_ESLINT_FIX=true

# 自动运行 Prettier 格式化
AUTO_PRETTIER_FORMAT=true

# ============================================
# Figma 资源处理
# ============================================

# 自动下载 Figma 资源
AUTO_DOWNLOAD_ASSETS=true

# 图片导出格式
IMAGE_EXPORT_FORMAT=png

# 图片导出缩放比例
IMAGE_EXPORT_SCALE=2

# 是否严格验证微码规范
STRICT_MC_VALIDATION=true

# ============================================
# 环境差异配置（gitignored，参考 .env.example.* 创建）
# ============================================
# .env               ← 基础共享配置（不含密钥/MongoDB URI）
# .env.development   ← 本地开发覆盖（本地 Mongo + debug 日志）
# .env.production    ← 云端生产覆盖（阿里云 Mongo + info 日志）
# app.module.ts 按 NODE_ENV 自动加载对应文件
