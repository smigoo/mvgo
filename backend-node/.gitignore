# ==== A4 安全整改：密钥/敏感配置 ====
# .env 含明文 AI/Figma 密钥，严禁入库；仅提交 .env.example 模板
.env
.env.*
!.env.example
!.env.development.example
!.env.production.example

# ==== 依赖 ====
node_modules/

# ==== 构建产物 ====
dist/
dist-*.tar.gz
# 构建备份目录（回滚用）：daily auto-sync 会 git add -A，必须忽略，
# 否则每天凌晨把旧构建（数千文件/数十 MB）重复提交进仓库
dist.bak.*
dist.old-*
dist.bak
dist.old

# ==== 日志 ====
logs/
*.log
server.log
server.log.*

# ==== 生成产物 / 临时 ====
temp-components/
output/
workspace/
# 运行时数据目录整体不入库（daily auto-sync 用 git add -A，逐项规则易漏）
data/
data/*.json
data/*.jsonl
data/*.db
data/*.tmp
data/*.bak-*
data/apifox-zips/
# 根目录探针残留（EPERM rename / 重启探针，0 字节）
.__*
.restart-probe*
.rename-probe*
# 微码解析失败 dump（运行时诊断产物，不入库）
data/microcode-parse-fail-*.txt
# Apifox 接口生成产物（个人隔离目录，不入库）
data/apifox/
data/apifox-tasks.json
# API 绑定快照（运行时生成，不入库）
data/api-binding-snapshots/
# 运行时数据目录（不入库；daily auto-sync 用 git add -A，会把它们扫进来）
data/api-catalogs/
data/figma-node-cache/
data/project-runs/
# 探针与回收站残留（EPERM rename 探针 / 组件删除回收站，0 字节或无用）
data/.__*
data/.__*/
data/.rename-probe-*
data/.restart-probe*
data/.trash/

# ==== 构建缓存 / 清理残留 ====
# TypeScript 增量编译缓存
*.tsbuildinfo
# 文件清理/恢复工具产生的临时副本
*.cleanup-*
# tsc 编译 scripts/ 时产出的声明与 sourcemap
scripts/*.d.ts
scripts/*.js.map
# 临时预览图目录
temp-preview-images/

# 服务端 AI 配置（含 API Key，严禁入库）
data/ai-config.json

# 本地连通性测试脚本可能含连接串，严禁入库
test-mongo-remote.js

# ==== 诊断/调试脚本（本地临时，不入库）====
check-user-configs.cjs
debug-*.mjs
probe-*.mjs
# 诊断/调试脚本与产物：不限扩展名（.js/.json/.png/.vue 等一律不入库）
.tmp-*
__replay-*.js

# mc-spec 规范检查报告（本地产物）
data/mc-spec-reports/
