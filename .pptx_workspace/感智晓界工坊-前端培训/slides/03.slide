<Slide paddingTop={20} paddingBottom={20} paddingLeft={64} paddingRight={64} style={{ width: '1280px', height: '720px', background: '#FFFFFF' }}>
  <Box style={{ height: 88, flexDirection: 'row', alignItems: 'center', gap: 16, borderLeftWidth: 6, borderLeftStyle: 'solid', borderLeftColor: '#1E3A8A', paddingLeft: 18 }}>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E293B' }}>为什么用平台，而不是本地 AI</Text>
    <Text style={{ fontSize: 20, color: '#64748B' }}>一句话铺垫</Text>
  </Box>

  <Box style={{ flex: 1, flexDirection: 'row', gap: 24, marginTop: 10 }}>
    <Box style={{ flex: 1, background: '#F1F5F9', borderRadius: 14, paddingTop: 26, paddingBottom: 26, paddingLeft: 26, paddingRight: 26, borderTopWidth: 6, borderTopStyle: 'solid', borderTopColor: '#0EA5E9', flexDirection: 'column', justifyContent: 'center' }}>
      <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#0EA5E9' }}>本地 AI（Cursor / Copilot）</Text>
      <Text style={{ fontSize: 20, color: '#475569', marginTop: 14, lineHeight: 1.5 }}>个人提效工具。资产散落个人仓库，规范随人，难以沉淀与复用。</Text>
    </Box>
    <Box style={{ flex: 1, background: '#EFF6FF', borderRadius: 14, paddingTop: 26, paddingBottom: 26, paddingLeft: 26, paddingRight: 26, borderTopWidth: 6, borderTopStyle: 'solid', borderTopColor: '#1E3A8A', flexDirection: 'column', justifyContent: 'center' }}>
      <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#1E3A8A' }}>感智晓界工坊平台</Text>
      <Text style={{ fontSize: 20, color: '#475569', marginTop: 14, lineHeight: 1.5 }}>团队 / 组织生产能力。强制 Vue3 / 微码规范、沉淀共享组件库、交付闭环一站完成。</Text>
    </Box>
  </Box>

  <Box style={{ marginTop: 16, background: '#FFF7ED', borderRadius: 10, paddingTop: 16, paddingBottom: 16, paddingLeft: 20, paddingRight: 20 }}>
    <Text style={{ fontSize: 20, color: '#1E293B', fontWeight: 'bold' }}>一句话：给每人发更快的锤子（本地 AI） vs 建一座共用标准化工厂（平台）。</Text>
  </Box>

  <Box style={{ height: 40, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
    <Text style={{ fontSize: 14, color: '#64748B' }}>感智晓界工坊 · 前端开发使用培训</Text>
    <Text style={{ fontSize: 14, color: '#64748B' }}>03 / 27</Text>
  </Box>
</Slide>
