<Slide paddingTop={20} paddingBottom={20} paddingLeft={64} paddingRight={64} style={{ width: '1280px', height: '720px', background: '#FFFFFF' }}>
  <Box style={{ height: 88, flexDirection: 'row', alignItems: 'center', gap: 16, borderLeftWidth: 6, borderLeftStyle: 'solid', borderLeftColor: '#1E3A8A', paddingLeft: 18 }}>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E293B' }}>如何使用③：在线迭代 + Playground / 沙盒</Text>
  </Box>

  <Box style={{ flex: 1, flexDirection: 'row', gap: 24, marginTop: 10 }}>
    <Box style={{ flex: 1, background: '#F1F5F9', borderRadius: 14, paddingTop: 24, paddingBottom: 24, paddingLeft: 24, paddingRight: 24, borderTopWidth: 6, borderTopStyle: 'solid', borderTopColor: '#1E3A8A', flexDirection: 'column', justifyContent: 'center' }}>
      <Text style={{ fontSize: 25, fontWeight: 'bold', color: '#1E3A8A' }}>Playground</Text>
      <Text style={{ fontSize: 19, color: '#475569', marginTop: 14, lineHeight: 1.55 }}>平台内置「组件工作台」，VS Code 风格 IDE（Monaco 编辑器，带格式化 + 行号），你 / AI 在这里直接改生成的组件代码；用自然语言说「把背景改成蓝色、加个 tab」，AI 在 Playground 里改代码并实时预览。</Text>
    </Box>
    <Box style={{ flex: 1, background: '#F1F5F9', borderRadius: 14, paddingTop: 24, paddingBottom: 24, paddingLeft: 24, paddingRight: 24, borderTopWidth: 6, borderTopStyle: 'solid', borderTopColor: '#0EA5E9', flexDirection: 'column', justifyContent: 'center' }}>
      <Text style={{ fontSize: 25, fontWeight: 'bold', color: '#0EA5E9' }}>沙盒（为什么敢改）</Text>
      <Text style={{ fontSize: 19, color: '#475569', marginTop: 14, lineHeight: 1.55 }}>组件在隔离沙盒里渲染 / 预览，与宿主、生产环境物理隔离——改坏只影响沙盒预览，不污染平台、不碰生产数据；每次生成与每次手改都留快照，改坏了可回到上一可用版本。</Text>
    </Box>
  </Box>

  <Box style={{ marginTop: 16, background: '#FFF7ED', borderRadius: 10, paddingTop: 16, paddingBottom: 16, paddingLeft: 20, paddingRight: 20 }}>
    <Text style={{ fontSize: 19, color: '#1E293B' }}>建议：小步快改，每次保存即一个新版本，便于对比与回退。</Text>
  </Box>

  <Box style={{ height: 40, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
    <Text style={{ fontSize: 14, color: '#64748B' }}>感智晓界工坊 · 前端开发使用培训</Text>
    <Text style={{ fontSize: 14, color: '#64748B' }}>13 / 27</Text>
  </Box>
</Slide>
