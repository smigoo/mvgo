<Slide paddingTop={20} paddingBottom={20} paddingLeft={64} paddingRight={64} style={{ width: '1280px', height: '720px', background: '#FFFFFF' }}>
  <Box style={{ height: 80, flexDirection: 'row', alignItems: 'center', gap: 16, borderLeftWidth: 6, borderLeftStyle: 'solid', borderLeftColor: '#1E3A8A', paddingLeft: 18 }}>
    <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#1E293B' }}>名词解释：开发环境术语</Text>
  </Box>

  <Box style={{ flex: 1, flexDirection: 'row', flexWrap: 'wrap', gap: 16, marginTop: 18 }}>
    <Box style={{ width: 560, background: '#F8FAFC', borderRadius: 12, paddingTop: 18, paddingBottom: 18, paddingLeft: 20, paddingRight: 20, borderLeftWidth: 4, borderLeftStyle: 'solid', borderLeftColor: '#14B8A6' }}>
      <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1E3A8A' }}>🗂️ Workspace</Text>
      <Text style={{ fontSize: 15, color: '#475569', marginTop: 8, lineHeight: 1.6 }}>生成产物的工作目录。默认路径 `backend-node/workspace/custom-components/`，存放通过质量门禁的组件源码；快照版本另存于 `temp-components/.task-code-snapshots/`。</Text>
    </Box>

    <Box style={{ width: 560, background: '#F8FAFC', borderRadius: 12, paddingTop: 18, paddingBottom: 18, paddingLeft: 20, paddingRight: 20, borderLeftWidth: 4, borderLeftStyle: 'solid', borderLeftColor: '#EF4444' }}>
      <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1E3A8A' }}>🚧 L0-B 门禁</Text>
      <Text style={{ fontSize: 15, color: '#475569', marginTop: 8, lineHeight: 1.6 }}>Layer-0 Block 质量门禁，组件生成后的第一道静态检查。校验 import 白名单、SFC 语义（模板裸标识符 vs script 声明）、LESS 编译通过性等，不通过则 BLOCK 并触发重试。</Text>
    </Box>

    <Box style={{ width: 560, background: '#F8FAFC', borderRadius: 12, paddingTop: 18, paddingBottom: 18, paddingLeft: 20, paddingRight: 20, borderLeftWidth: 4, borderLeftStyle: 'solid', borderLeftColor: '#F59E0B' }}>
      <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1E3A8A' }}>📄 declare.json</Text>
      <Text style={{ fontSize: 15, color: '#475569', marginTop: 8, lineHeight: 1.6 }}>微码组件元数据描述文件，与 `package/index.vue` 同级。声明组件名称、版本、属性（props）、事件、插槽、资源变量等，供运行时渲染引擎解析。</Text>
    </Box>

    <Box style={{ width: 560, background: '#F8FAFC', borderRadius: 12, paddingTop: 18, paddingBottom: 18, paddingLeft: 20, paddingRight: 20, borderLeftWidth: 4, borderLeftStyle: 'solid', borderLeftColor: '#8B5CF6' }}>
      <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1E3A8A' }}>🎨 CSS Vars</Text>
      <Text style={{ fontSize: 15, color: '#475569', marginTop: 8, lineHeight: 1.6 }}>CSS 自定义属性（CSS Custom Properties），微码组件通过 `css-vars.js` 声明主题变量，运行时由 `$mcComponentBuilder` 注入，实现一套组件多主题切换。</Text>
    </Box>

    <Box style={{ width: 560, background: '#F8FAFC', borderRadius: 12, paddingTop: 18, paddingBottom: 18, paddingLeft: 20, paddingRight: 20, borderLeftWidth: 4, borderLeftStyle: 'solid', borderLeftColor: '#0EA5E9' }}>
      <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1E3A8A' }}>🔄 HMR（热模块替换）</Text>
      <Text style={{ fontSize: 15, color: '#475569', marginTop: 8, lineHeight: 1.6 }}>Hot Module Replacement，Vite 开发服务器核心能力。修改组件源码后浏览器实时更新，无需全页刷新；前端 dev 服务端口 2610。</Text>
    </Box>

    <Box style={{ width: 560, background: '#F8FAFC', borderRadius: 12, paddingTop: 18, paddingBottom: 18, paddingLeft: 20, paddingRight: 20, borderLeftWidth: 4, borderLeftStyle: 'solid', borderLeftColor: '#10B981' }}>
      <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1E3A8A' }}>🛝 Playground</Text>
      <Text style={{ fontSize: 15, color: '#475569', marginTop: 8, lineHeight: 1.6 }}>交互式组件预览与 AI对话式修改器。集成 Monaco 编辑器（支持格式化、行号、语法高亮），支持自然语言指令修改微码组件，基于 LangGraph 实现。</Text>
    </Box>
  </Box>

  <Box style={{ height: 40, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
    <Text style={{ fontSize: 14, color: '#64748B' }}>感智晓界工坊 · 前端开发使用培训</Text>
    <Text style={{ fontSize: 14, color: '#64748B' }}>30 / 30</Text>
  </Box>
</Slide>
