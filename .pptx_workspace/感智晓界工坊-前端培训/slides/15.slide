<Slide paddingTop={20} paddingBottom={20} paddingLeft={64} paddingRight={64} style={{ width: '1280px', height: '720px', background: '#FFFFFF' }}>
  <Box style={{ height: 80, flexDirection: 'row', alignItems: 'center', gap: 16, borderLeftWidth: 6, borderLeftStyle: 'solid', borderLeftColor: '#1E3A8A', paddingLeft: 18 }}>
    <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#1E293B' }}>如何使用⑤：一键交付 + 产物集成进项目</Text>
  </Box>

  <Box style={{ flex: 1, flexDirection: 'column', gap: 9, marginTop: 8 }}>
    <Box style={{ flex: 1, flexDirection: 'row', alignItems: 'center', gap: 16, background: '#F1F5F9', borderRadius: 10, paddingLeft: 22, paddingRight: 22 }}>
      <Box style={{ width: 44, height: 44, borderRadius: 22, background: '#1E3A8A', justifyContent: 'center', alignItems: 'center' }}>
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#FFFFFF' }}>1</Text>
      </Box>
      <Box style={{ flex: 1, flexDirection: 'row', alignItems: 'center', gap: 14 }}>
        <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#1E293B' }}>获取产物</Text>
        <Text style={{ fontSize: 18, color: '#475569' }}>平台下载 zip，或一键推 Git（门禁通过后）。</Text>
      </Box>
    </Box>
    <Box style={{ flex: 1, flexDirection: 'row', alignItems: 'center', gap: 16, background: '#F1F5F9', borderRadius: 10, paddingLeft: 22, paddingRight: 22 }}>
      <Box style={{ width: 44, height: 44, borderRadius: 22, background: '#0EA5E9', justifyContent: 'center', alignItems: 'center' }}>
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#FFFFFF' }}>2</Text>
      </Box>
      <Box style={{ flex: 1, flexDirection: 'row', alignItems: 'center', gap: 14 }}>
        <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#1E293B' }}>微码怎么用</Text>
        <Text style={{ fontSize: 18, color: '#475569' }}>按平台组件引用方式，在业务页登记 / 引入组件，传参即可。</Text>
      </Box>
    </Box>
    <Box style={{ flex: 1, flexDirection: 'row', alignItems: 'center', gap: 16, background: '#F1F5F9', borderRadius: 10, paddingLeft: 22, paddingRight: 22 }}>
      <Box style={{ width: 44, height: 44, borderRadius: 22, background: '#1E3A8A', justifyContent: 'center', alignItems: 'center' }}>
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#FFFFFF' }}>3</Text>
      </Box>
      <Box style={{ flex: 1, flexDirection: 'row', alignItems: 'center', gap: 14 }}>
        <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#1E293B' }}>Vue3 怎么用</Text>
        <Text style={{ fontSize: 18, color: '#475569' }}>把生成目录拷入工程 components/，按普通 Vue3 组件 import 使用。</Text>
      </Box>
    </Box>
    <Box style={{ flex: 1, flexDirection: 'row', alignItems: 'center', gap: 16, background: '#F1F5F9', borderRadius: 10, paddingLeft: 22, paddingRight: 22 }}>
      <Box style={{ width: 44, height: 44, borderRadius: 22, background: '#0EA5E9', justifyContent: 'center', alignItems: 'center' }}>
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#FFFFFF' }}>4</Text>
      </Box>
      <Box style={{ flex: 1, flexDirection: 'row', alignItems: 'center', gap: 14 }}>
        <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#1E293B' }}>对接接口</Text>
        <Text style={{ fontSize: 18, color: '#475569' }}>组件内已按 APIFOX 绑定真实接口字段，联调时核对字段即可。</Text>
      </Box>
    </Box>
    <Box style={{ flex: 1, flexDirection: 'row', alignItems: 'center', gap: 16, background: '#F1F5F9', borderRadius: 10, paddingLeft: 22, paddingRight: 22 }}>
      <Box style={{ width: 44, height: 44, borderRadius: 22, background: '#1E3A8A', justifyContent: 'center', alignItems: 'center' }}>
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#FFFFFF' }}>5</Text>
      </Box>
      <Box style={{ flex: 1, flexDirection: 'row', alignItems: 'center', gap: 14 }}>
        <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#1E293B' }}>后续维护</Text>
        <Text style={{ fontSize: 18, color: '#475569' }}>改样式 / 逻辑回到平台在线迭代，或本地改后重新推送，保持单一来源。</Text>
      </Box>
    </Box>
    <Box style={{ flex: 1, flexDirection: 'row', alignItems: 'center', gap: 16, background: '#F1F5F9', borderRadius: 10, paddingLeft: 22, paddingRight: 22 }}>
      <Box style={{ width: 44, height: 44, borderRadius: 22, background: '#F59E0B', justifyContent: 'center', alignItems: 'center' }}>
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#FFFFFF' }}>6</Text>
      </Box>
      <Box style={{ flex: 1, flexDirection: 'row', alignItems: 'center', gap: 14 }}>
        <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#1E293B' }}>提醒</Text>
        <Text style={{ fontSize: 18, color: '#475569' }}>先小范围试点（1 个组件），跑通再推广。</Text>
      </Box>
    </Box>
  </Box>

  <Box style={{ height: 40, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
    <Text style={{ fontSize: 14, color: '#64748B' }}>感智晓界工坊 · 前端开发使用培训</Text>
    <Text style={{ fontSize: 14, color: '#64748B' }}>15 / 27</Text>
  </Box>
</Slide>
