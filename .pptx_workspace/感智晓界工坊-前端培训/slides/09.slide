<Slide paddingTop={16} paddingBottom={16} paddingLeft={64} paddingRight={64} style={{ width: '1280px', height: '720px', background: '#FFFFFF' }}>
  <Box style={{ height: 80, flexDirection: 'row', alignItems: 'center', gap: 16, borderLeftWidth: 6, borderLeftStyle: 'solid', borderLeftColor: '#1E3A8A', paddingLeft: 18 }}>
    <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#1E293B' }}>优缺点对比：本地 AI vs 团队协同 vs 平台</Text>
  </Box>

  <Box style={{ flex: 1, flexDirection: 'column', justifyContent: 'center', marginTop: 4 }}>
    <Table
      style={{ width: '100%' }}
      defaultTextStyle={{ fontSize: 15, color: '#1E293B' }}
      defaultCellStyle={{
        borderLeftWidth: 1, borderLeftStyle: 'solid', borderLeftColor: '#E2E8F0',
        borderRightWidth: 1, borderRightStyle: 'solid', borderRightColor: '#E2E8F0',
        borderTopWidth: 1, borderTopStyle: 'solid', borderTopColor: '#E2E8F0',
        borderBottomWidth: 1, borderBottomStyle: 'solid', borderBottomColor: '#E2E8F0',
        paddingTop: 8, paddingBottom: 8, paddingLeft: 12, paddingRight: 12,
      }}
      cells={[
        [
          { text: '维度', textStyle: { bold: true, color: '#FFFFFF', fontSize: 16 }, cellStyle: { background: '#1E3A8A' } },
          { text: '本地 AI（个人）', textStyle: { bold: true, color: '#FFFFFF', fontSize: 16 }, cellStyle: { background: '#1E3A8A' } },
          { text: '团队协同', textStyle: { bold: true, color: '#FFFFFF', fontSize: 16 }, cellStyle: { background: '#1E3A8A' } },
          { text: '感智晓界工坊平台', textStyle: { bold: true, color: '#FFFFFF', fontSize: 16 }, cellStyle: { background: '#0EA5E9' } },
        ],
        [
          { text: '提效幅度', textStyle: { bold: true, fontSize: 15 } },
          '个人 +30~50%',
          '团队一致',
          { text: '组织级倍增', textStyle: { color: '#0EA5E9', bold: true, fontSize: 15 } },
        ],
        [
          { text: '规范一致性', textStyle: { bold: true, fontSize: 15 } },
          '低（随人）',
          '中（靠约定）',
          { text: '高（强制 Vue3/微码）', textStyle: { color: '#0EA5E9', bold: true, fontSize: 15 } },
        ],
        [
          { text: '资产沉淀', textStyle: { bold: true, fontSize: 15 } },
          '无（散落）',
          '部分（团队库）',
          { text: '强（共享库 + 评分反哺）', textStyle: { color: '#0EA5E9', bold: true, fontSize: 15 } },
        ],
        [
          { text: '交付闭环', textStyle: { bold: true, fontSize: 15 } },
          '无',
          '部分（手动推）',
          { text: '完整（门禁 + Git + 接口）', textStyle: { color: '#0EA5E9', bold: true, fontSize: 15 } },
        ],
        [
          { text: '学习成本', textStyle: { bold: true, fontSize: 15 } },
          '低',
          '中',
          { text: '中（一次配置全员复用）', textStyle: { color: '#0EA5E9', bold: true, fontSize: 15 } },
        ],
        [
          { text: '适用场景', textStyle: { bold: true, fontSize: 15 } },
          '个人原型 / 小工具',
          '团队常规项目',
          { text: '标准化业务组件', textStyle: { color: '#0EA5E9', bold: true, fontSize: 15 } },
        ],
      ]}
    />
    <Box style={{ marginTop: 12, background: '#FFF7ED', borderRadius: 10, paddingTop: 12, paddingBottom: 12, paddingLeft: 18, paddingRight: 18 }}>
      <Text style={{ fontSize: 18, color: '#1E293B' }}>一句话：本地 AI 解决「个人快」，团队协同解决「一致」，平台解决「组织能持续生产」。</Text>
    </Box>
  </Box>

  <Box style={{ height: 40, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
    <Text style={{ fontSize: 14, color: '#64748B' }}>感智晓界工坊 · 前端开发使用培训</Text>
    <Text style={{ fontSize: 14, color: '#64748B' }}>09 / 27</Text>
