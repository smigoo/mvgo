<Slide paddingTop={16} paddingBottom={16} paddingLeft={64} paddingRight={64} style={{ width: '1280px', height: '720px', background: '#FFFFFF' }}>
  <Box style={{ height: 76, flexDirection: 'row', alignItems: 'center', gap: 16, borderLeftWidth: 6, borderLeftStyle: 'solid', borderLeftColor: '#1E3A8A', paddingLeft: 18 }}>
    <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#1E293B' }}>常见问题</Text>
    <Text style={{ fontSize: 20, color: '#64748B' }}>高频疑问与对策</Text>
  </Box>

  <Box style={{ flex: 1, flexDirection: 'column', gap: 12, marginTop: 6 }}>
    <Box style={{ flex: 1, flexDirection: 'row', gap: 14 }}>
      <Box style={{ flex: 1, background: '#F1F5F9', borderRadius: 10, paddingTop: 12, paddingBottom: 12, paddingLeft: 16, paddingRight: 16, flexDirection: 'column', justifyContent: 'center' }}>
        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1E3A8A' }}>Q1 Figma 还原度不足？</Text>
        <Text style={{ fontSize: 15, color: '#475569', marginTop: 4 }}>检查设计稿图层命名与规范映射。</Text>
      </Box>
      <Box style={{ flex: 1, background: '#F1F5F9', borderRadius: 10, paddingTop: 12, paddingBottom: 12, paddingLeft: 16, paddingRight: 16, flexDirection: 'column', justifyContent: 'center' }}>
        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1E3A8A' }}>Q2 Lite 适用边界？</Text>
        <Text style={{ fontSize: 15, color: '#475569', marginTop: 4 }}>简单页用 Lite，正式复杂页用完整版。</Text>
      </Box>
      <Box style={{ flex: 1, background: '#F1F5F9', borderRadius: 10, paddingTop: 12, paddingBottom: 12, paddingLeft: 16, paddingRight: 16, flexDirection: 'column', justifyContent: 'center' }}>
        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1E3A8A' }}>Q3 组件规范冲突？</Text>
        <Text style={{ fontSize: 15, color: '#475569', marginTop: 4 }}>Vue3 / 微码 / 一体化按兼容策略处理。</Text>
      </Box>
    </Box>
    <Box style={{ flex: 1, flexDirection: 'row', gap: 14 }}>
      <Box style={{ flex: 1, background: '#F1F5F9', borderRadius: 10, paddingTop: 12, paddingBottom: 12, paddingLeft: 16, paddingRight: 16, flexDirection: 'column', justifyContent: 'center' }}>
        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1E3A8A' }}>Q4 微码学习成本？</Text>
        <Text style={{ fontSize: 15, color: '#475569', marginTop: 4 }}>规范初学不低，但 AI 生成已帮你跨过样板与配置。</Text>
      </Box>
      <Box style={{ flex: 1, background: '#F1F5F9', borderRadius: 10, paddingTop: 12, paddingBottom: 12, paddingLeft: 16, paddingRight: 16, flexDirection: 'column', justifyContent: 'center' }}>
        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1E3A8A' }}>Q5 Playground / 沙盒？</Text>
        <Text style={{ fontSize: 15, color: '#475569', marginTop: 4 }}>在线改代码的隔离环境，试错都在沙盒里。</Text>
      </Box>
      <Box style={{ flex: 1, background: '#F1F5F9', borderRadius: 10, paddingTop: 12, paddingBottom: 12, paddingLeft: 16, paddingRight: 16, flexDirection: 'column', justifyContent: 'center' }}>
        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1E3A8A' }}>Q6 门禁 BLOCK 怎么处理？</Text>
        <Text style={{ fontSize: 15, color: '#475569', marginTop: 4 }}>看行列级报错 → 在线改 → 重校验 → 强制预览。</Text>
      </Box>
    </Box>
    <Box style={{ flex: 1, flexDirection: 'row', gap: 14 }}>
      <Box style={{ flex: 1, background: '#F1F5F9', borderRadius: 10, paddingTop: 12, paddingBottom: 12, paddingLeft: 16, paddingRight: 16, flexDirection: 'column', justifyContent: 'center' }}>
        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1E3A8A' }}>Q7 接口对接失败？</Text>
        <Text style={{ fontSize: 15, color: '#475569', marginTop: 4 }}>核对 APIFOX 目录与字段是否匹配。</Text>
      </Box>
      <Box style={{ flex: 1, background: '#F1F5F9', borderRadius: 10, paddingTop: 12, paddingBottom: 12, paddingLeft: 16, paddingRight: 16, flexDirection: 'column', justifyContent: 'center' }}>
        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1E3A8A' }}>Q8 Git 推送门禁？</Text>
        <Text style={{ fontSize: 15, color: '#475569', marginTop: 4 }}>质量门禁未过先修再推，不绕行。</Text>
      </Box>
      <Box style={{ flex: 1, background: '#FFF7ED', borderRadius: 10, paddingTop: 12, paddingBottom: 12, paddingLeft: 16, paddingRight: 16, flexDirection: 'column', justifyContent: 'center' }}>
        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#F59E0B' }}>Q9 产物怎么用？</Text>
        <Text style={{ fontSize: 15, color: '#475569', marginTop: 4 }}>见 P15 一键交付 + 产物集成。</Text>
      </Box>
    </Box>
  </Box>

  <Box style={{ height: 40, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
    <Text style={{ fontSize: 14, color: '#64748B' }}>感智晓界工坊 · 前端开发使用培训</Text>
    <Text style={{ fontSize: 14, color: '#64748B' }}>25 / 27</Text>
  </Box>
</Slide>
